# Azure OpenAI Configuration
# Uncomment and fill in your Azure OpenAI credentials
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_AUTH_MODE=key  # or 'token' for Azure AD authentication

# LiteLLM Proxy (optional)
# LITE_LLM_API_KEY=your-litellm-key
# LITE_LLM_API_BASE=https://api.litellm.com

# Provider API Keys
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# LLAMA_API_KEY=your-llama-key
# GEMINI_API_KEY=your-gemini-key

# Tool API Keys
# SEARCHAPI_API_KEY=your-searchapi-key
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# OPENWEATHER_API_KEY=your-openweather-key
# WOLFRAM_ALPHA_API_KEY=your-wolfram-key
# SPHERE_ENGINE_API_KEY=your-sphere-engine-key
